# Copy to .env and set real values for anything beyond local dev.
# docker-compose reads .env automatically; .env itself is gitignored,
# only this example (with placeholder values) is committed.

# Postgres (docker-compose's postgres service)
POSTGRES_DB=snapfind
POSTGRES_USER=snapfind
POSTGRES_PASSWORD=snapfind

# MinIO / object storage (docker-compose's minio service).
# MinIO requires the root password to be at least 8 characters.
MINIO_ROOT_USER=snapfind
MINIO_ROOT_PASSWORD=snapfind123
S3_BUCKET=snapfind
